#!/usr/bin/env zsh
source ${0:A:h}/../../deploy

install() {
  # herdr: an agent multiplexer that lives in your terminal https://herdr.dev
  brew install herdr
  herdr integration install claude
  case $(_os) in
    macos)
      # herdr-app: the desktop app (config in ~/.config/herdr-app)
      brew install --cask herdr-app
      ;;
  esac
}

update() {
  brew upgrade herdr
  case $(_os) in
    macos) brew upgrade --cask herdr-app ;;
  esac
}

link() {
  # herdr reads ~/.config/herdr/config.toml and writes its logs alongside it,
  # so only symlink the config file (mirrors the tmux topic) to keep logs out
  # of the repo rather than symlinking the whole directory.
  mklink $DOTTY_CONFIG_HOME/shell/herdr/config.toml $XDG_CONFIG_HOME/herdr/

  # herdr-app (the desktop app) reads ~/.config/herdr-app and rewrites its own
  # generated files (AGENTS.md, mods/, layouts/, ...) there, so only symlink
  # the files we own: keys, settings and custom themes.
  local app_src=$DOTTY_CONFIG_HOME/shell/herdr/herdr-app
  local app_dst=$XDG_CONFIG_HOME/herdr-app
  mkdir -p $app_dst/themes
  mklink $app_src/keys.json $app_src/settings.json $app_dst/
  mklink $app_src/themes/acario-light.json $app_dst/themes/

  # terminal-acario layout + its two mods (whole mod dirs are linked; the app
  # also drops generated gpui-kit.d.ts/jsconfig.json there, ignored via
  # herdr-app/.gitignore).
  mkdir -p $app_dst/layouts $app_dst/mods
  mklink $app_src/layouts/terminal-acario.json $app_dst/layouts/
  mklink $app_src/mods/terminal-acario-bar $app_src/mods/terminal-acario-pane $app_src/mods/terminal-acario-agents $app_src/mods/terminal-acario-spaces $app_dst/mods/

  # herdr-app will not load images through symlinks (a symlinked mod dir or file
  # draws nothing), so icons the mods use are copied as real files.
  mkdir -p $app_dst/icons
  cp -f $app_src/custom-icons/*.svg $app_dst/icons/
}

clean() {
  rm -f $XDG_CONFIG_HOME/herdr/config.toml
  rm -f $XDG_CONFIG_HOME/herdr-app/keys.json \
    $XDG_CONFIG_HOME/herdr-app/settings.json \
    $XDG_CONFIG_HOME/herdr-app/themes/acario-light.json \
    $XDG_CONFIG_HOME/herdr-app/layouts/terminal-acario.json
  rm -f $XDG_CONFIG_HOME/herdr-app/mods/terminal-acario-bar \
    $XDG_CONFIG_HOME/herdr-app/mods/terminal-acario-pane \
    $XDG_CONFIG_HOME/herdr-app/mods/terminal-acario-agents \
    $XDG_CONFIG_HOME/herdr-app/mods/terminal-acario-spaces \
    $XDG_CONFIG_HOME/herdr-app/icons/copied.svg \
    $XDG_CONFIG_HOME/herdr-app/icons/acario-done.svg \
    $XDG_CONFIG_HOME/herdr-app/icons/acario-alert.svg \
    $XDG_CONFIG_HOME/herdr-app/icons/acario-error.svg
}

init "$@"
