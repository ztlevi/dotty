#!/usr/bin/env zsh
source ${0:A:h}/../../deploy

install() {
  brew install gh jq python3
  case $(_os) in
    macos)
      # brew install --cask claude-code
      ;;
    linux*)
      # curl -fsSL https://claude.ai/install.sh | bash
      ;;
  esac

  ! topic-enabled-p dev/node && dotty dev/node

  # Install skills
  gh extension install ai-ecoverse/gh-upskill
  gh upskill -g anthropics/skills --skill pdf --skill xlsx
  gh upskill -g ogulcancelik/herdr --skill herdr
  gh upskill -g yizhiyanhua-ai/fireworks-tech-graph --skill fireworks-tech-graph
}

update() {
  brew upgrade gh
  gh extension upgrade upskill
}

# Link a tracked MCP config to $2. If the git-ignored mcp-local.json exists, write
# base + local (deep-merged) as a real file instead of a symlink.
link_mcp() {
  local base=$1 dest=$2 local_cfg=$DOTTY_CONFIG_HOME/misc/ai/config/mcp-local.json
  if [[ -f $local_cfg ]] && _is_callable jq; then
    [[ -L $dest || -e $dest ]] && /bin/rm -f $dest
    jq -s '.[0] * .[1]' $base $local_cfg > $dest && echo-ok "merged $local_cfg into $dest"
  else
    mklink $base $dest
  fi
}

# Tools rewrite their config files (replacing symlinks with real files), so those files are
# merged instead of linked. See config/misc/ai/merge_config.py for the per-format semantics.
merge_config() {
  local src=$1 dest=$2
  if python3 $DOTTY_CONFIG_HOME/misc/ai/merge_config.py $src $dest; then
    echo-ok "merged $src into $dest"
  else
    echo-fail "failed to merge $src into $dest"
  fi
}

link() {
  # Amazon codex installation expects the toolbox binary here
  if [[ -e ~/.toolbox/bin/claude ]]; then
    mkdir -p ~/.claude
    local f
    for f in $DOTTY_CONFIG_HOME/misc/ai/claude/*; do
      [[ ${f:t} == settings.json ]] || mklink $f ~/.claude/
    done
    # claude replaces a symlinked settings.json with a real file: merge both ways instead
    merge_config $DOTTY_CONFIG_HOME/misc/ai/claude/settings.json ~/.claude/settings.json
    link_mcp $DOTTY_CONFIG_HOME/misc/ai/claude/mcp.json ~/.claude/mcp.json
  fi

  # Amazon codex installation expects the toolbox binary here
  if [[ -e ~/.toolbox/bin/codex ]]; then
    mkdir -p ~/.codex
    [[ $USER == zhot ]] && merge_config $DOTTY_CONFIG_HOME/misc/ai/codex/config.toml ~/.codex/config.toml
    mklink $DOTTY_CONFIG_HOME/misc/ai/codex/AGENTS.md ~/.codex/AGENTS.md

    mkdir -p ~/.codex/packages/standalone/current
    mklink ~/.toolbox/bin/codex ~/.codex/packages/standalone/current/codex
  fi

  # Amazon codex installation expects the toolbox binary here
  if [[ -e ~/.toolbox/bin/kiro-cli ]]; then
    mkdir -p ~/.kiro/settings
    link_mcp $DOTTY_CONFIG_HOME/misc/ai/config/mcp.json ~/.kiro/settings/mcp.json
    mklink $DOTTY_CONFIG_HOME/misc/ai/kiro/agents/* ~/.kiro/agents/
    mklink $DOTTY_CONFIG_HOME/misc/ai/kiro/settings/* ~/.kiro/settings/
  fi
}

clean() {
  rm -rf ~/.codex
  rm -rf ~/.claude
  rm -rf ~/.kiro/settings
}

init "$@"
